<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Overview · Goan Craving Admin</title><link rel="stylesheet" href="/css/style.css"></head>
<body><div class="shell"><aside class="sidebar"><a class="brand" href="/admin"><span class="brand-icon">🍲</span><span>Goan Craving<small>ADMIN CONSOLE</small></span></a><p class="nav-label">WORKSPACE</p><nav class="nav"><a class="active" href="/admin">▦ &nbsp; Overview</a><a href="/admin#orders">▤ &nbsp; Orders</a><a href="/admin#customers">♙ &nbsp; Customers</a><a href="/admin/employees">♧ &nbsp; Employees</a><a href="/admin#analytics">▥ &nbsp; Analytics & Reports</a></nav><p class="nav-label">MANAGE</p><a class="nav-link" href="/admin#settings">⚙ &nbsp; Settings</a><div class="sidebar-foot"><b>Admin workspace</b><p>Monitor store performance and team activity.</p></div></aside>
<main class="main"><header class="topbar"><div><div class="crumb">Workspace / Overview</div><h1>Good morning, Admin 👋</h1><p class="muted">Here’s what’s happening with your store.</p></div><div class="top-actions"><select id="range" class="select"><option>Today</option><option>Yesterday</option><option>Last 7 days</option><option>Last 30 days</option><option>This month</option><option>Last month</option><option>This year</option><option>Last year</option></select><div class="dropdown-wrap"><button class="button-light" id="createToggle">＋ Create ▾</button><div class="dropdown" id="createMenu"><a href="/admin/employees">Add employee</a><button data-modal="Create report">Create report</button><button data-modal="Add order">Add order</button></div></div><div class="user-pill"><span class="avatar">A</span><span><b>Admin</b><small><%= adminEmail %></small></span></div><form action="/admin/logout" method="post"><button class="button-light" type="submit">Log out</button></form></div></header>
<section class="metrics"><article class="metric"><div class="metric-label">Total revenue <span>₹</span></div><strong id="revenue">₹<%= metrics.revenue.toLocaleString("en-IN") %></strong><small class="positive">↗ 12.8% <em>vs previous period</em></small></article><article class="metric"><div class="metric-label">Orders <span>▤</span></div><strong id="orders"><%= metrics.orders %></strong><small class="positive">↗ 8.2% <em>vs previous period</em></small></article><article class="metric"><div class="metric-label">Total customers <span>♙</span></div><strong><%= metrics.customers.toLocaleString("en-IN") %></strong><small class="positive">↗ 6.4% <em>new customers</em></small></article><article class="metric"><div class="metric-label">Average order value <span>↗</span></div><strong>₹<%= metrics.averageOrder %></strong><small class="positive">↗ 3.1% <em>vs previous period</em></small></article></section>
<section class="content-grid"><article class="panel"><div class="panel-head"><div><h2>Revenue overview</h2><p class="muted">Revenue trend · <span id="rangeLabel">Today</span></p></div><button class="button-light" id="exportCsv">Export CSV</button></div><div class="chart" id="chart" aria-label="Revenue chart"></div><div class="chart-labels" id="chartLabels"></div></article><article class="panel"><div class="panel-head"><div><h2>Order status</h2><p class="muted">Current order breakdown</p></div><a class="text-link" href="/admin#orders">View all</a></div><div class="status-list"><% orderStatuses.forEach(item => { %><div class="status-item"><div><span><%= item.label %></span><b><%= item.count %></b></div><div class="progress"><i class="<%= item.tone %>" style="width:<%= item.percent %>%"></i></div></div><% }) %></div><div class="employee-summary"><span>Employees</span><b><%= activeEmployees %> active <small>/ <%= totalEmployees %> total</small></b><a href="/admin/employees">Manage team →</a></div></article></section>
<section class="panel recent" id="orders"><div class="panel-head"><div><h2>Recent orders</h2><p class="muted">Latest order activity</p></div><a class="text-link" href="#orders">View all orders →</a></div><div class="table-scroll"><table><thead><tr><th>ORDER</th><th>CUSTOMER</th><th>AMOUNT</th><th>STATUS</th></tr></thead><tbody><% recentOrders.forEach(order => { %><tr><td>#<%= order.id %></td><td><%= order.customer %></td><td>₹<%= order.amount %></td><td><span class="badge <%= order.status.toLowerCase().replaceAll(" ", "-") %>"><%= order.status %></span></td></tr><% }) %></tbody></table></div></section>
</main></div><div class="modal-backdrop" id="modalBackdrop"><div class="modal"><button class="modal-close" id="modalClose" aria-label="Close">×</button><h2 id="modalTitle">Action</h2><p class="muted">This section is ready for connection to your store API.</p><div class="modal-actions"><button class="primary" id="modalOk">Got it</button></div></div></div><script src="/js/dashboard.js"></script></body></html>
