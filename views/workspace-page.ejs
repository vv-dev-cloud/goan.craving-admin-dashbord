<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= page.title %> · Goan Craving Admin</title><link rel="stylesheet" href="/css/style.css"></head>
<body><div class="shell"><aside class="sidebar"><a class="brand" href="/admin"><span class="brand-icon">🍲</span><span>Goan Craving<small>ADMIN CONSOLE</small></span></a><p class="nav-label">WORKSPACE</p><nav class="nav"><a href="/admin">▦ &nbsp; Overview</a><a class="<%= active === 'orders' ? 'active' : '' %>" href="/admin/orders">▤ &nbsp; Orders</a><a class="<%= active === 'customers' ? 'active' : '' %>" href="/admin/customers">♙ &nbsp; Customers</a><a href="/admin/employees">♧ &nbsp; Employees</a><a class="<%= active === 'analytics' ? 'active' : '' %>" href="/admin/analytics">▥ &nbsp; Analytics</a><a class="<%= active === 'reports' ? 'active' : '' %>" href="/admin/reports">▧ &nbsp; Reports</a><a class="<%= active === 'activity' ? 'active' : '' %>" href="/admin/activity">◷ &nbsp; Employee activity</a></nav><p class="nav-label">MANAGE</p><a class="nav-link <%= active === 'settings' ? 'active' : '' %>" href="/admin/settings">⚙ &nbsp; Settings</a><div class="sidebar-foot"><b>Admin workspace</b><p>Manage Goan Craving operations.</p></div></aside>
<main class="main"><header class="topbar"><div><div class="crumb"><a href="/admin">Workspace</a> / <%= page.title %></div><h1><%= page.title %></h1><p class="muted"><%= page.subtitle %></p></div><div class="top-actions"><a class="button-light" href="/admin">← Overview</a><div class="dropdown-wrap"><button class="button-light" id="createToggle">＋ Create ▾</button><div class="dropdown" id="createMenu"><a href="/admin/employees">Add employee</a><a href="/admin/reports">Create report</a></div></div><div class="user-pill"><span class="avatar">A</span><span><b>Admin</b><small>Goan Craving</small></span></div></div></header>
<section class="workspace-hero"><div><span class="badge active">Admin workspace</span><p class="muted">Dedicated page for <%= page.title.toLowerCase() %>.</p></div></section><section class="workspace-tiles"><% page.cards.forEach((item,i)=>{ %><article class="workspace-tile"><div class="tile-icon"><%= page.icon %></div><b><%= item %></b><p class="muted">Overview and management</p></article><% }) %></section><section class="panel"><div class="panel-head"><div><h2><%= page.title %> workspace</h2><p class="muted">Page layout is in place</p></div></div><div class="workspace-note"><strong>Data connection required</strong><%= page.note %></div></section></main></div><script>const t=document.querySelector('#createToggle'),m=document.querySelector('#createMenu');t?.addEventListener('click',()=>m.classList.toggle('open'));document.addEventListener('click',e=>{if(!e.target.closest('.dropdown-wrap'))m?.classList.remove('open')});</script></body></html>