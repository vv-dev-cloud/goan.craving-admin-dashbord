<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin sign in · Goan Craving</title><link rel="stylesheet" href="/css/style.css"></head>
<body class="login-body"><main class="login-card"><a class="brand" href="/">🍲 <span>Goan Craving <small>ADMIN CONSOLE</small></span></a><h1>Welcome back</h1><p class="muted">Sign in to manage your restaurant operations.</p><% if (error) { %><div class="alert"><%= error %></div><% } %><form method="post" action="/admin/login"><label>Email address</label><input name="email" type="email" autocomplete="username" required placeholder="admin@goancraving.com"><label>Password</label><input name="password" type="password" autocomplete="current-password" required placeholder="Your admin password"><button class="primary full" type="submit">Sign in</button></form><p class="hint">Admin access is configured with environment variables.</p></main></body></html>
