<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Employees · Goan Craving</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="shell"><aside class="sidebar"><a class="brand" href="/admin"><span class="brand-icon">🍲</span><span>Goan Craving<small>ADMIN CONSOLE</small></span></a><p class="nav-label">WORKSPACE</p><nav class="nav"><a href="/admin">▦ &nbsp; Overview</a><a href="/admin/orders">▤ &nbsp; Orders</a><a href="/admin/customers">♙ &nbsp; Customers</a><a href="/admin/employees" class="active">♧ &nbsp; Employees</a><a href="/admin/analytics">▥ &nbsp; Analytics</a><a href="/admin/reports">▧ &nbsp; Reports</a><a href="/admin/activity">◷ &nbsp; Activity</a><a href="/admin/settings">⚙ &nbsp; Settings</a></nav><div class="sidebar-foot">Employee account management</div></aside><main class="main"><header class="topbar"><div><div class="crumb"><a href="/admin">Workspace</a> / Employees</div><h1>Employees</h1><p class="muted">Create and manage staff access.</p></div><a class="button-light" href="/admin">← Dashboard</a></header><% if (notice) { %><div class="notice"><%= notice %></div><% } %><section class="panel"><div class="panel-head"><div><h2>Add employee</h2><p class="muted">A unique employee ID and temporary password are generated automatically.</p></div></div><form class="employee-form" method="post" action="/admin/employees"><label>Full name<input name="name" required placeholder="Employee name"></label><label>Email<input type="email" name="email" required placeholder="employee@example.com"></label><label>Role<select name="role"><option>Order manager</option><option>Kitchen staff</option><option>Delivery coordinator</option></select></label><button class="primary" type="submit">Create employee</button></form></section><section class="panel recent"><div class="panel-head"><div><h2>Team members</h2><p class="muted"><%= employees.length %> employee accounts</p></div></div><div class="table-scroll"><table><thead><tr><th>EMPLOYEE ID</th><th>NAME</th><th>EMAIL</th><th>ROLE</th><th>STATUS</th><th>ACTION</th></tr></thead><tbody><% if (!employees.length) { %><tr><td colspan="6">No employees yet. Add your first team member above.</td></tr><% } %><% employees.forEach(emp => { %><tr><td><%= emp.employeeId %></td><td><%= emp.name %></td><td><%= emp.email %></td><td><%= emp.role %></td><td><span class="badge <%= emp.status.toLowerCase() %>"><%= emp.status %></span></td><td><form method="post" action="/admin/employees/<%= emp._id %>/status"><input type="hidden" name="status" value="<%= emp.status === 'Active' ? 'Inactive' : 'Active' %>"><button class="button-light small" type="submit"><%= emp.status === "Active" ? "Deactivate" : "Activate" %></button></form></td></tr><% }) %></tbody></table></div></section></main></div></body></html>
